{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "@kmjtechno/main-platform",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vp build",
        "build:ssr": "vp build && vp build --ssr",
        "dev": "vp dev",
        "check": "vp check && node --test scripts/check-catalog-category-order.test.mjs scripts/check-public-navigation.test.mjs scripts/check-homepage-portfolio.test.mjs scripts/check-owner-dashboard.test.mjs scripts/check-operator-command-center.test.mjs scripts/check-owner-product-editor-state.test.mjs scripts/check-admin-premium.test.mjs scripts/check-admin-roadmap-navigation.test.mjs scripts/check-command-os-visual-lock.test.mjs scripts/check-codebridge-safe-onboarding.test.mjs scripts/check-codebridge-dashboard-truth.test.mjs scripts/check-payment-onboarding.test.mjs scripts/check-brand-assets.test.mjs scripts/check-auth-focus-order.test.mjs scripts/check-licensing-integration.test.mjs scripts/check-no-auto-reload.test.mjs scripts/check-registration-email-contract.test.mjs scripts/check-codebridge-oauth-security.test.mjs && node scripts/check-public-layout.mjs && node --test scripts/check-public-discovery.test.mjs",
        "check:fix": "vp check --fix",
        "types:check": "tsc --noEmit",
        "visual:dev": "vite --config visual/vite.config.ts",
        "visual:build": "vite build --config visual/vite.config.ts",
        "visual:verify": "node scripts/run-browser-preview.mjs",
        "visual:install": "playwright install chromium"
    },
    "dependencies": {
        "@inertiajs/react": "^3.0.0",
        "@inertiajs/vite": "^3.0.0",
        "@laravel/passkeys": "^0.2.0",
        "@radix-ui/react-avatar": "^1.1.3",
        "@radix-ui/react-checkbox": "^1.1.4",
        "@radix-ui/react-collapsible": "^1.1.3",
        "@radix-ui/react-dialog": "^1.1.6",
        "@radix-ui/react-dropdown-menu": "^2.1.6",
        "@radix-ui/react-label": "^2.1.2",
        "@radix-ui/react-navigation-menu": "^1.2.5",
        "@radix-ui/react-select": "^2.1.6",
        "@radix-ui/react-separator": "^1.1.2",
        "@radix-ui/react-slot": "^1.2.3",
        "@radix-ui/react-toggle": "^1.1.2",
        "@radix-ui/react-toggle-group": "^1.1.2",
        "@radix-ui/react-tooltip": "^1.1.8",
        "@tailwindcss/vite": "^4.1.11",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^6.1.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "concurrently": "^10.0.3",
        "input-otp": "^1.4.2",
        "laravel-vite-plugin": "^3.0.0",
        "lucide-react": "^0.475.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "sonner": "^2.0.0",
        "tailwind-merge": "^3.0.1",
        "tailwindcss": "^4.0.0",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.7.2",
        "vite": "^8.3.3"
    },
    "devDependencies": {
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@rolldown/plugin-babel": "^0.2.3",
        "@types/node": "^22.13.5",
        "babel-plugin-react-compiler": "^1.0.0",
        "playwright": "1.62.1",
        "vite-plus": "0.3.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1",
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@rollup/rollup-win32-x64-msvc": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1",
        "lightningcss-win32-x64-msvc": "^1.29.1"
    },
    "overrides": {
        "tinypool": "2.1.2"
    }
}
