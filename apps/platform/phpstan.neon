includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    # Self-hosted CI already parallelizes frontend/backend across separate runners.
    # Keep PHPStan itself single-process so shared-host child-process spawning cannot
    # fail nondeterministically while preserving the full level-7 analysis.
    parallel:
        maximumNumberOfProcesses: 1
