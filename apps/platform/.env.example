APP_NAME="KMJ TECHNO"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
PUBLIC_INDEXING_ENABLED=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=kmj_main
DB_USERNAME=kmj
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Temporary Brevo Free transactional SMTP (300/day, no paid overage intended).
# Default stays MAIL_MAILER=log until your sending domain and authorized
# real-inbox test have passed. Never commit or chat-paste an SMTP key.
# To activate privately after verification: MAIL_MAILER=kmj_brevo
KMJ_BREVO_ACTIVATED=false
KMJ_BREVO_SMTP_LOGIN=
KMJ_BREVO_SMTP_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# CodeBridge OAuth 2.1 authorization server.
# Production can use APP_KEY-derived signing material when a dedicated key is absent.
# Set CODEBRIDGE_OAUTH_SIGNING_KEY to a base64 Ed25519 seed/key for independent key rotation.
CODEBRIDGE_OAUTH_ENABLED=false
CODEBRIDGE_OAUTH_ISSUER=
CODEBRIDGE_OAUTH_RESOURCE=
CODEBRIDGE_OAUTH_SIGNING_KEY=
CODEBRIDGE_OAUTH_KID=codebridge-oauth-1

# Outbound CodeBridge agent browser enrollment public HTTPS origin.
# Keep separate from the private CODEBRIDGE_GATEWAY_URL MCP upstream.
# Production operator verifies protected /agent/health 401 and release guards
# before privately configuring CODEBRIDGE_AGENT_PUBLIC_URL=https://kmjtechno.com.
# Blank is intentionally fail-closed; NEVER fallback to localhost/private URL.
CODEBRIDGE_AGENT_PUBLIC_URL=

