[Unit]
Description=KMJ TECHNO owner-queued release prepare broker (runs the pinned owner helper in bounded modes; never activates)
Documentation=https://github.com/kmjtechno/kmj-main-platform/blob/main/docs/operations/ELITE_RELEASE_PREPARE_BROKER_20261123.md

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/
ExecStart=/usr/bin/python3 -I -B /opt/kmj-main-platform-release-evidence/elite_release_prepare_broker.py --execute
StateDirectory=kmj-main-platform/release-prepare
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=4500
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
