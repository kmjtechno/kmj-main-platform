[Unit]
Description=KMJ-elite remotely managed Cloudflare Tunnel (IP independent HTTP/S)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/cloudflared/kmj-elite-ip-independent.token

[Service]
Type=simple
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel run --token-file /etc/cloudflared/kmj-elite-ip-independent.token
Restart=always
RestartSec=10s
TimeoutStartSec=90s
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
