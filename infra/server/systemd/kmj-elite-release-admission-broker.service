[Unit]
Description=KMJ TECHNO owner-queued release admission broker (writes the gate admission only from verified receipts)
Documentation=https://github.com/kmjtechno/kmj-main-platform/blob/main/docs/operations/RELEASE_ADMISSION_COLLECTOR_DESIGN_20261122.md
ConditionPathExists=/home/kmjprod/shared/storage/app/private/ops/release-admission-request.json

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/
ExecStart=/usr/bin/python3 -I -B /opt/kmj-main-platform-release-evidence/elite_admission_broker.py --execute
StateDirectory=kmj-main-platform/admission-broker
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=120
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/kmj-main-platform/admission-broker /etc/kmj-codebridge /home/kmjprod/shared/storage/app/private/ops
