[Unit]
Description=KMJ Elite verified current and approved candidate Nginx SHA map
After=network-online.target nginx.service
Wants=network-online.target
# Avoid recurring Git/Nginx work on idle admission-timer ticks.
ConditionPathExists=|/home/kmjprod/shared/storage/app/private/ops/release-admission-request.json
ConditionPathExists=|/run/kmj-production-sha-map-qualification

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/
ExecStart=/usr/bin/python3 -I -B /opt/kmj-main-platform-release-evidence/refresh_production_release_sha_map.py --apply
StateDirectory=kmj-main-platform/production-sha-map
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=240
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/etc/nginx/conf.d
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
