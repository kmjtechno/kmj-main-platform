+def protected_snapshot_bytes(path, digest):
+    if str(path) != os.path.abspath(path) or str(path) != os.path.realpath(path):
+        stop("SNAPSHOT_DEPENDENCY_PATH_UNSAFE")
+    for parent in path.parents:
+        info = os.lstat(parent)
+        if (not stat.S_ISDIR(info.st_mode) or info.st_uid not in {0, SNAPSHOT_INSTALL_UID}
+                or info.st_mode & 0o022):
+            # A sticky system temporary ancestor is allowed by the attestor;
+            # the actual installation remains under protected /usr/local.
+            if not (stat.S_ISDIR(info.st_mode) and info.st_uid == 0 and info.st_mode & stat.S_ISVTX):
+                stop("SNAPSHOT_DEPENDENCY_ANCESTOR_UNSAFE")
+    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
+    try:
+        info = os.fstat(fd)
+        if (not stat.S_ISREG(info.st_mode) or info.st_uid != SNAPSHOT_INSTALL_UID
+                or info.st_nlink != 1 or info.st_mode & 0o022 or info.st_size > 1024 * 1024):
+            stop("SNAPSHOT_DEPENDENCY_UNSAFE")
+        with os.fdopen(os.dup(fd), "rb") as stream:
+            raw = stream.read(1024 * 1024 + 1)
+        if hashlib.sha256(raw).hexdigest() != digest:
+            stop("SNAPSHOT_DEPENDENCY_HASH_MISMATCH")
+        current = os.lstat(path)
+        stamp = lambda s: (s.st_dev, s.st_ino, s.st_size, s.st_mtime_ns, s.st_ctime_ns)
+        if stamp(current) != stamp(info) or stamp(os.fstat(fd)) != stamp(info):
+            stop("SNAPSHOT_DEPENDENCY_CHANGED")
+        return raw
+    finally:
+        os.close(fd)
+
+
+def load_snapshot_attestor():
