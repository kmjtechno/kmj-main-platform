# CloudOS-scoped Main Platform runtime configuration — NON-SECRET EXAMPLE.
# Provision from a secret store at release time; NEVER commit APP_KEY,
# DB_PASSWORD, REDIS_PASSWORD, SMTP credentials or signing secrets.
# Independent PostgreSQL / Redis-compatible systems MUST already be running.
# Do not activate this file on the existing production VPS.
APP_ENV=production
APP_DEBUG=false
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
# Redis host/socket, database name, TLS/ACL, connection pools and AUTH:
# inject from CloudOS secure runtime config; NOT defaults in Git.
# SESSION_COOKIE should remain securely scoped; CloudOS must preserve HTTPS.
# Public CDN caching is only allowed for immutable assets, not authenticated views.
# Per-node PHP threads/OPcache settings require measured CPU/RAM benchmark.
