[Unit]
Description=KMJ curated backlog to durable autonomy queue
After=kmj-autonomy-worker.service
[Service]
Type=oneshot
WorkingDirectory=@RUNTIME@
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ExecStart=%h/.kmj-python313/bin/python3 -m controller.backlog_coordinator --backlog @RUNTIME@/ops/autonomy/product-backlog.json --codebridge-status %h/.local/state/kmj-autonomy/codebridge-status.json --db %h/.local/state/kmj-autonomy/queue.sqlite --state-root %h/.local/state/kmj-autonomy --status %h/.local/state/kmj-autonomy/product-backlog-status.json --max-codebridge-age 900
